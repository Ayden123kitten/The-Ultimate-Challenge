```gitignore
# Dependencies
node_modules/

# Environment variables
.env
.env.local
*.env.*

# Logs and temporary files
*.log
*.tmp
*.swp

# Editors
.vscode/
.idea/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
venv/
.venv/
.env

# Build outputs
dist/
build/
*.egg-info/

# OS generated files
.DS_Store
Thumbs.db

# Coverage reports
coverage/
htmlcov/
.coverage

# MyPy cache
.mypy_cache/
# Pytest cache
.pytest_cache/
```